@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_WriterLayout.cshtml";
}

<div class="row">
    <div class="col-md-12 grid-margin">
        <div class="row">
            <div class="col-12 col-xl-8 mb-4 mb-xl-0">
                <h3 class="font-weight-bold">Welcome @ViewBag.o</h3>
                <br>
                <h6 class="font-weight-normal mb-0">
                    ASP.NET CORE DASHBOARD PANEL !
                    <span class="d-block mt-2">
                        <a href="/Writer/Default/Index/">Click</a> for new announcements!
                    </span>
                </h6>
            </div>
            <div class="col-12 col-xl-4">
                <div class="justify-content-end d-flex">
                    <div class="dropdown flex-md-grow-1 flex-xl-grow-0">
                        <button class="btn btn-sm btn-light" type="button">
                            <i class="mdi mdi-calendar"></i> Today <br> (@DateTime.Now.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture))
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-6 grid-margin stretch-card">
        <div class="card tale-bg">
            <div class="card-people mt-auto">
                <img src="~/skydash/images/dashboard/people.svg" alt="people">
                <div class="weather-info">
                    <div class="d-flex">
                        <div>
                            <h2 class="mb-0 font-weight-normal"><i class="icon-sun mr-2"></i>@ViewBag.v5<sup>C</sup></h2>
                        </div>
                        <div class="ml-2">
                            <h4 class="location font-weight-normal">Istanbul</h4>
                            <h6 class="font-weight-normal">Turkey</h6>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 grid-margin transparent">
        <div class="row">
            <div class="col-md-6 mb-4 stretch-card transparent">
                <div class="card card-tale">
                    <div class="card-body">
                        <p class="mb-4">Number of Incoming Messages</p>
                        <p class="fs-30 mb-2">@ViewBag.v1</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 mb-4 stretch-card transparent">
                <div class="card card-dark-blue">
                    <div class="card-body">
                        <p class="mb-4">Number of Announcement</p>
                        <p class="fs-30 mb-2">@ViewBag.v2</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-4 mb-lg-0 stretch-card transparent">
                <div class="card card-light-blue">
                    <div class="card-body">
                        <p class="mb-4">Total Number of Users</p>
                        <p class="fs-30 mb-2">@ViewBag.v3</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 stretch-card transparent">
                <div class="card card-light-danger">
                    <div class="card-body">
                        <p class="mb-4">Number of Talents</p>
                        <p class="fs-30 mb-2">@ViewBag.v4</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="row">
    <div class="col-md-6 grid-margin">
        <div class="card">
            <div class="card-body">
                <p class="card-title">Writer Panel</p>
                <p class="font-weight-500">This is the page that contains messages, announcements, etc. information for writers. If you need help, you can contact us via the contact section.</p>
                <div class="d-flex flex-wrap">
                    <div class="mr-5 mt-3">
                        <p class="text-muted mb-1">Order value</p>
                        <h3 class="text-primary fs-30 font-weight-medium mb-0">12.3k</h3>
                    </div>
                    <div class="mr-5 mt-3">
                        <p class="text-muted mb-1">Orders</p>
                        <h3 class="text-primary fs-30 font-weight-medium mb-0">14k</h3>
                    </div>
                    <div class="mr-5 mt-3">
                        <p class="text-muted mb-1">Users</p>
                        <h3 class="text-primary fs-30 font-weight-medium mb-0">71.56%</h3>
                    </div>
                    <div class="mt-3">
                        <p class="text-muted mb-1">Downloads</p>
                        <h3 class="text-primary fs-30 font-weight-medium mb-0">34040</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 grid-margin">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <p class="card-title">Help Menu</p>
                </div>
                <p class="font-weight-500 mb-0">If you have any problems while using the application, you can write to us immediately and our team will contact you as soon as possible.</p>
            </div>
        </div>
    </div>
</div>