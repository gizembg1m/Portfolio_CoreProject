@using EntityLayer.Concrete
@model List<Contact>

<div class="col-md-6" data-aos="zoom-in" data-aos-delay="100">
    <div class="bg-light my-2 p-3 pt-2">
        <form action="/Default/SendMessage/" method="post">
            <div class="form-group my-2">
                <label for="name" class="form-label fw-bolder">Your Name</label>
                <input class="form-control" type="text" id="name" name="Name" required style="background-color: #FFF0F3; border-color: #FFB6C1;">
            </div>
            <div class="form-group my-2">
                <label for="email" class="form-label fw-bolder">Your Email</label>
                <input class="form-control" type="email" id="email" name="Mail" required style="background-color: #FFF0F3; border-color: #FFB6C1;">
            </div>
            <div class="form-group my-2">
                <label for="message" class="form-label fw-bolder">Your Message</label>
                <textarea class="form-control" style="resize: none; background-color: #FFF0F3; border-color: #FFB6C1;" id="message" name="Content" rows="4" required></textarea>
            </div>
            <button class="btn mt-2" type="submit" style="background-color: #FFB6C1; border-color: #FFB6C1; color: #000000;">Send</button>
        </form>
    </div>
</div>