@using EntityLayer.Concrete
@model List<About>

<div class="section pt-4 px-3 px-lg-4" id="about">
    <div class="container-narrow">
        @foreach (var item in Model)
        {
            <div class="row align-items-center">
                
                <div class="col-md-7">
                    <h2 class="h4 my-2">@item.Title</h2>
                    <p>@item.Description</p>

                    <div class="row mt-3">
                        <div class="col-4 col-sm-3 pb-2 text-secondary">Age:</div>
                        <div class="col-8 col-sm-9 pb-2 fw-bolder">@item.Age</div>

                        <div class="col-4 col-sm-3 pb-2 text-secondary">Email:</div>
                        <div class="col-8 col-sm-9 pb-2 fw-bolder text-break">@item.Mail</div>

                        <div class="col-4 col-sm-3 pb-2 text-secondary">Phone:</div>
                        <div class="col-8 col-sm-9 pb-2 fw-bolder">@item.Phone</div>

                        <div class="col-4 col-sm-3 pb-2 text-secondary">Address:</div>
                        <div class="col-8 col-sm-9 pb-2 fw-bolder">@item.Address</div>
                    </div>
                </div>

                
                <div class="col-md-5 text-center" data-aos="fade-left" data-aos-delay="100">
                    <img class="avatar img-fluid mt-2 rounded"
                         src="@item.ImageUrl"
                         alt="@item.Title"
                         style="max-width: 100%; height: auto; object-fit: cover;" />
                </div>
            </div>
        }
    </div>
</div>