@using EntityLayer.Concrete
@model List<Feature>
<header>
    <div class="cover bg-light">
        <div class="container px-3">
            <div class="row">
                <div class="col-lg-6 p-2">
                    <img class="img-fluid w-100 rounded" src="~/Template/images/illustrations/icongirl.jpg" alt="hello" />
                </div>
                <div class="col-lg-6">
                    @foreach (var item in Model)
                    {
                        <div class="mt-5">
                            <p class="lead text-uppercase mb-1">@item.Header!</p>
                            <h1 class="intro-title marker"
                                style="--marker-color: #FFB6C1;"
                                data-aos="fade-left"
                                data-aos-delay="50">
                                @item.Name
                            </h1>
                            <p class="lead fw-normal mt-3" data-aos="fade-up" data-aos-delay="100">@item.Title</p>

                            @await Component.InvokeAsync("SocialMediaList")

                            <div class="mt-3" data-aos="fade-up" data-aos-delay="200">
                                <a class="btn shadow-sm mt-1 hover-effect" style="background-color: #FFB6C1 !important; border-color: #FFB6C1 !important; color: #000 !important;" href="#contact">
                                    Get In Touch <i class="fas fa-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="wave-bg"></div>
</header>