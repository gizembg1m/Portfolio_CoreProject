@model EntityLayer.Concrete.Skill
@{
    ViewData["Title"] = "AddSkill";
    Layout = "~/Views/Shared/_NewAdminLayout.cshtml";
}
<div class="col-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <p class="card-description"> Add New Skill Panel </p>
            <form class="forms-sample" method="post">
                <div class="form-group">
                    <label>Title</label>
                    @Html.TextBoxFor(x => x.Title, new { @class = "form-control" })
                    @Html.ValidationMessageFor(x => x.Title, "", new { @class = "text-danger" })
                </div>
                <div class="form-group">
                    <label>Value</label>
                    @Html.TextBoxFor(x => x.Value, new { @class = "form-control" })
                    @Html.ValidationMessageFor(x => x.Value, "", new { @class = "text-danger" })
                </div>
                <button type="submit" class="btn btn-outline-primary mr-2">Save</button>
                <a href="/Skill/Index/" class="btn btn-outline-light">Cancel</a>
            </form>
        </div>
    </div>
</div>